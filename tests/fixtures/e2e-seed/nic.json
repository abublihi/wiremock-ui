{
  "integrations": [
    { "key": "nic", "name": "NIC", "prefix": "/nic", "description": "National information center: citizen records." }
  ],
  "catalog": [
    {
      "integration": "nic",
      "key": "fetch-citizen",
      "name": "Fetch citizen",
      "method": "POST",
      "path": "/citizens/fetch",
      "pathType": "exact",
      "lookup": { "location": "jsonPath", "expression": "$.idNo" },
      "contentType": "json",
      "allowedStatuses": [200, 404],
      "exampleRequest": "{\"idNo\":\"1012345678\"}",
      "exampleResponses": {
        "200": "{\"idNo\":\"1012345678\",\"name\":\"Test Citizen\",\"status\":\"active\"}",
        "404": "{\"error\":\"citizen not found\"}"
      },
      "description": "Looks up one citizen by national ID number."
    }
  ],
  "mocks": [
    {
      "id": "6f0f8a52-2b1f-4c43-9d3e-0b7c2c1f0e01",
      "name": "NIC health (baseline)",
      "request": { "method": "GET", "urlPath": "/nic/health" },
      "response": { "status": 200, "jsonBody": { "status": "up" }, "headers": { "Content-Type": "application/json" } },
      "metadata": { "wiremockUi": { "integration": "nic" } }
    }
  ]
}
