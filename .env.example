# Required
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
SESSION_SECRET=change-me-to-a-random-string-of-32-chars
REDIS_URL=redis://localhost:6379

# WireMock admin API basic auth (compose passes these to WireMock and the UI)
WIREMOCK_ADMIN_USER=wiremock-admin
WIREMOCK_ADMIN_PASSWORD=change-me-wiremock

# Optional (defaults shown). Under docker compose, WIREMOCK_URL and REDIS_URL
# are overridden to http://wiremock:8080 and redis://redis:6379.
WIREMOCK_URL=http://localhost:8080
STORE_DRIVER=redis
SYNC_INTERVAL_SECONDS=5
LOG_LEVEL=info
PORT=3000
