{
  "name": "wiremock-ui",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && vite build -c vite.cli.config.ts",
    "cli": "node --experimental-sqlite --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/cli/wiremock-ui.mjs",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vite build && playwright test"
  },
